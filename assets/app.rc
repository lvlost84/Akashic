// 버전 자리표시자(@VER@ 등)는 build.rs가 Cargo.toml의 version으로 채운다. 직접 고치지 말 것.
#pragma code_page(65001)
1 ICON "icon.ico"
1 VERSIONINFO
FILEVERSION @VER_COMMA@
PRODUCTVERSION @VER_COMMA@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204b0"
    BEGIN
      VALUE "FileDescription", "아카식 - 오프라인 마크다운 노트"
      VALUE "ProductName", "아카식"
      VALUE "FileVersion", "@VER@"
      VALUE "ProductVersion", "@VER@"
      VALUE "OriginalFilename", "Akashic.exe"
      VALUE "InternalName", "Akashic"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END